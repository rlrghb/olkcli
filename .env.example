# Optional: Override the default embedded client ID
# OLK_CLIENT_ID=your-azure-app-client-id

# Optional: Specify tenant (defaults to "common" for both personal + enterprise)
# OLK_TENANT_ID=your-tenant-id

# Optional: Override config directory (defaults to ~/.config/olkcli/)
# OLK_CONFIG_DIR=/path/to/config

# Optional: Default output format
# OLK_JSON=true
# OLK_PLAIN=true

# Optional: Default account for multi-account setups
# OLK_ACCOUNT=user@example.com

# Optional: Color mode
# OLK_COLOR=auto

# Capability guards (apply to CLI, MCP, and scripts alike)
# OLK_NO_WRITE=1            # refuse any mutating operation
# OLK_NO_SEND=1             # refuse sending mail / meeting invites
# OLK_NO_INPUT=1            # fail instead of prompting (headless/agent safety)
# OLK_WRAP_UNTRUSTED=1      # wrap external free-text in untrusted-content markers (JSON/plain)

# Command allow/deny lists (comma-separated dotted paths)
# OLK_ENABLE_COMMANDS=mail,calendar
# OLK_ENABLE_COMMANDS_EXACT=mail.list,mail.get
# OLK_DISABLE_COMMANDS=mail.send

# MCP server (olk mcp)
# OLK_MCP_ALLOW_WRITE=1     # also expose curated write tools (drafts/todo create)
