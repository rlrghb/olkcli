# Optional: Override the default embedded client ID
# OLK_CLIENT_ID=your-azure-app-client-id

# Optional: Specify tenant (defaults to "common" for both personal + enterprise)
# OLK_TENANT_ID=your-tenant-id

# Optional: Override config directory (defaults to ~/.config/olkcli/)
# OLK_CONFIG_DIR=/path/to/config

# Optional: Default output format
# OLK_JSON=true
# OLK_PLAIN=true

# Optional: Default account for multi-account setups
# OLK_ACCOUNT=user@example.com

# Optional: Color mode
# OLK_COLOR=auto

# Optional: MCP server (olk mcp) configuration
# OLK_MCP_PROFILE=safe          # stdio / legacy-HTTP profile: safe|full
# OLK_MCP_HTTP=:8765            # serve streamable HTTP instead of stdio (empty = stdio)
# OLK_MCP_TOKEN=...             # legacy single bearer token (serves one profile)
# OLK_MCP_TOKEN_FILE=/path      # read the legacy token from a file
# OLK_MCP_KEY_SAFE=...          # API key granting the safe profile over HTTP
# OLK_MCP_KEY_FULL=...          # API key granting the full profile over HTTP (destructive)
# OLK_MCP_KEY_SAFE_FILE=/path   # read the safe key from a file (0600)
# OLK_MCP_KEY_FULL_FILE=/path   # read the full key from a file (0600)
